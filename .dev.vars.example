# Local Cloudflare development only. Copy to .dev.vars (ignored by Git).
# Use a Neon test branch, never the production database for automated tests.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="90d"
# Needed only when a separate Vite origin connects to Wrangler locally.
CORS_ORIGIN="http://localhost:5173,http://127.0.0.1:5173"
