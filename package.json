{
  "name": "math-monopoly",
  "version": "1.0.0",
  "private": true,
  "description": "Adaptive Learning Monopoly Game powered by BKT",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev:cloudflare",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "build": "npm run build --workspace=frontend && npm run build --workspace=backend",
    "deploy": "npm run build && wrangler deploy",
    "setup:cloudflare": "node scripts/cloudflare-setup.mjs",
    "lint": "npm run lint --workspaces && eslint scripts",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build",
    "build:cloudflare": "npm run build",
    "dev:cloudflare": "npm run build --workspace=frontend && wrangler dev",
    "deploy:cloudflare": "npm run deploy",
    "test:e2e": "npm run test:e2e --workspace=frontend",
    "test:cloudflare": "npm run build:cloudflare && node --test scripts/cloudflare.integration.test.mjs",
    "dev:cloudflare:test": "npm run build:cloudflare && node scripts/cloudflare-test-runtime.mjs"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261009.1",
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.28.1",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "miniflare": "^5.20261006.1-alpha",
    "typescript-eslint": "^8.67.0",
    "wrangler": "^4.149.0"
  }
}
