# ============================================
# Backend Environment Variables
# Copy to .env and fill in. All values are validated at startup
# by src/config/env.ts — a bad value fails the boot with a clear message.
# ============================================

# Server
PORT=3001
NODE_ENV=development

# ---- Database (Neon) ----
# Pooled connection, used at runtime. On Neon this host contains "-pooler".
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Direct connection, used only by `prisma migrate`. PgBouncer cannot run
# migrations, so this must be the NON-pooled host (no "-pooler").
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require"

# ---- Auth ----
# Must be at least 16 characters. Generate with: openssl rand -base64 32
JWT_SECRET=change-me-to-a-long-random-string
# Long-lived on purpose: the token IS the player's identity. Shortening it
# would reset a player's BKT mastery every time it expired.
JWT_EXPIRES_IN=90d

# ---- CORS ----
# Comma-separated list of allowed frontend origins.
CORS_ORIGIN=http://localhost:5173
