# ============================================
# Local database administration variables
# Copy to .env for Prisma migrations and skill seeding.
# Worker runtime secrets are configured separately with Wrangler.
# ============================================

# ---- Database (Neon) ----
# Pooled connection for local database tools. On Neon the host contains "-pooler".
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Direct connection, used only by `prisma migrate`. PgBouncer cannot run
# migrations, so this must be the NON-pooled host (no "-pooler").
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require"
