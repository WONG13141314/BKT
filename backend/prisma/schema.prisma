// Math Monopoly — database schema
//
// Scope note: live game state (positions, money, properties, turn phase) is NOT
// stored here. It lives in memory in `game.service.ts` for the duration of a
// match. Postgres holds the things that must outlive a match: who the player is,
// what the BKT engine believes about them, and the evidence behind that belief.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Pooled connection (Neon: the "-pooler" host) used at runtime.
  url       = env("DATABASE_URL")
  // Direct, unpooled connection used for migrations. PgBouncer cannot run them.
  directUrl = env("DIRECT_URL")
}

// ============================================
// Enums
// ============================================

enum PlayerRole {
  PLAYER
  ADMIN
}

enum GameStatus {
  PLAYING
  FINISHED
  ABANDONED
}

// ============================================
// Identity
//
// Anonymous-first. A Player row is created the first time someone types a
// nickname and is then remembered on that device forever. Claiming a username
// and PIN is optional and only exists to move a profile between devices.
// ============================================

model Player {
  id          String     @id @default(uuid())
  displayName String
  avatar      String     @default("tophat")
  role        PlayerRole @default(PLAYER)

  // Optional cross-device claim. Null until the player opts in.
  username  String? @unique
  pinHash   String?
  isClaimed Boolean @default(false)

  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  masteryStates    MasteryState[]
  questionAttempts QuestionAttempt[]
  gamePlayers      GamePlayer[]

  @@map("players")
}

// ============================================
// Skills & the learner model
// ============================================

model Skill {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())

  masteryStates    MasteryState[]
  questionAttempts QuestionAttempt[]

  @@map("skills")
}

/// One BKT chain per (player, skill). This is what makes the game adaptive
/// across sessions rather than resetting every match.
model MasteryState {
  id       String @id @default(uuid())
  playerId String
  skillId  String

  pMastery Float @default(0.1) // P(L) — probability the player knows the skill
  attempts Int   @default(0)
  correct  Int   @default(0)

  lastPracticedAt DateTime?
  updatedAt       DateTime  @updatedAt

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  skill  Skill  @relation(fields: [skillId], references: [id])

  @@unique([playerId, skillId])
  @@map("mastery_states")
}

/// Self-contained record of one answered question.
///
/// Questions are generated at runtime, so there is no question bank to point at
/// — the generated item is stored inline instead. `pMasteryBefore` and
/// `predictedPCorrect` are the model's prediction *before* it saw the answer and
/// cannot be reconstructed afterwards, so they are written at answer time.
model QuestionAttempt {
  id       String  @id @default(uuid())
  playerId String
  skillId  String
  gameId   String?

  difficulty Int
  context    String // ROLL_CHALLENGE / SMART_BUY / RENT_DEFENSE / ...

  questionData   Json
  correctAnswer  String
  selectedAnswer String? // null when the player ran out of time
  isCorrect      Boolean
  timedOut       Boolean @default(false)

  timeMs    Int?
  hintLevel Int  @default(0)

  pMasteryBefore    Float
  pMasteryAfter     Float
  predictedPCorrect Float // pL·(1−pS) + (1−pL)·pG
  opportunityIndex  Int // 1,2,3… per (player, skill) — the x-axis of a learning curve

  answeredAt DateTime @default(now())

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  skill  Skill  @relation(fields: [skillId], references: [id])

  @@index([playerId, skillId, opportunityIndex])
  @@index([gameId])
  @@map("question_attempts")
}

// ============================================
// Match history
//
// A finished-game snapshot for the profile page. Not a live mirror of game state.
// ============================================

model Game {
  id        String     @id // "game_<ROOMCODE>"
  roomCode  String
  status    GameStatus @default(PLAYING)
  round     Int        @default(0)
  maxRounds Int        @default(12)
  createdAt DateTime   @default(now())
  endedAt   DateTime?

  players GamePlayer[]

  @@index([roomCode])
  @@map("games")
}

model GamePlayer {
  id       String  @id @default(uuid())
  gameId   String
  playerId String? // null for bots

  name      String
  isBot     Boolean @default(false)
  color     String
  turnOrder Int

  finalCash      Int  @default(0)
  finalNetWorth  Int  @default(0)
  rank           Int?
  totalCorrect   Int  @default(0)
  totalQuestions Int  @default(0)

  game   Game    @relation(fields: [gameId], references: [id], onDelete: Cascade)
  player Player? @relation(fields: [playerId], references: [id], onDelete: SetNull)

  @@unique([gameId, turnOrder])
  @@map("game_players")
}
