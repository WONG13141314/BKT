{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mathopoly",
  "main": "backend/src/cloudflare/worker.ts",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "MathopolyGameRoom" },
      { "name": "API", "class_name": "MathopolyApi" },
      { "name": "PLAYERS", "class_name": "MathopolyPlayerDirectory" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GameRoom", "ApiService", "PlayerDirectory"] },
    { "tag": "v2", "renamed_classes": [{ "from": "ApiService", "to": "MathopolyApiService" }] },
    { "tag": "v3", "new_sqlite_classes": ["MathopolyGameRoom", "MathopolyApi", "MathopolyPlayerDirectory"] },
    { "tag": "v4", "deleted_classes": ["GameRoom", "MathopolyApiService", "PlayerDirectory"] }
  ],
  "vars": { "JWT_EXPIRES_IN": "90d" }
}
