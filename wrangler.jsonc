{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "monomath",
  "main": "backend/src/cloudflare/worker.ts",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "GameRoom" },
      { "name": "API", "class_name": "ApiService" },
      { "name": "PLAYERS", "class_name": "PlayerDirectory" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameRoom", "ApiService", "PlayerDirectory"] }],
  "vars": { "JWT_EXPIRES_IN": "90d" }
}
